# 复制为 .env.deploy 后填写；该文件已被 .gitignore 忽略，不要提交。
# 建议使用只拥有目标 Bucket 写入/列举权限的 RAM 子账号。

OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret

# 可选：上传到 Bucket 下的子目录，例如 rag-client；留空表示根目录。
OSS_PREFIX=

# 可选：自定义 Endpoint，不填则按 Region 使用默认地址。
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# 可选：并发上传数，默认 8。
# OSS_CONCURRENCY=8
